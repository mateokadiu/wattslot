{
  "name": "wattslot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @wattslot/db generate",
    "check": "biome ci . && turbo run typecheck test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}
