{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wattslot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "wattslot.mateokadiu.com", "custom_domain": true }],
  // The website is a static export served from the edge; only the API runs Worker code.
  "assets": {
    "directory": "../web/out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/v1/*", "/health", "/openapi.json"]
  },
  // The free plan allows 5 Cron Triggers per account; one dispatches every task.
  "triggers": { "crons": ["*/5 * * * *"] },
  // `off` pauses the outage overview (PLAN.md §17.4) without a code change.
  "vars": { "OUTAGES": "on" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wattslot",
      "database_id": "2800affd-18a7-41e7-8bca-db8c46163b4f",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
